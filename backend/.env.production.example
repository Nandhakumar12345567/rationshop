# ===================================================
# 🌾 Smart Ration Production Environment Template (.env)
# ===================================================

PORT=5000
NODE_ENV=production
JWT_SECRET=smart_ration_production_secure_jwt_secret_key_2026

# Force PostgreSQL in Production
USE_POSTGRES=true

# Production Cloud Database URL (AWS RDS / Azure PostgreSQL / Supabase)
DATABASE_URL=postgresql://postgres_user:YourStrongPassword123@your-db-instance.c123456789.ap-south-1.rds.amazonaws.com:5432/smart_ration_prod

# Redis Server for Socket.io Pub/Sub Scaling
REDIS_URL=redis://default:RedisPassword123@your-redis-host:6379

# Official Government SMS Gateway Credentials (CDAC MSDG / MSG91)
SMS_API_KEY=your_production_sms_api_key
SMS_SENDER_ID=TNPDS

# Razorpay UPI Production Live Credentials
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
